{
  "name": "goono-note-tablet",
  "private": true,
  "version": "0.1.0",
  "description": "구노 연구노트 태블릿 앱 — 오프라인 작성 후 구노 ELN에 동기화 (iPad·갤럭시 탭)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "node mock-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "playwright": "^1.59.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16"
  }
}
