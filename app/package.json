{
  "name": "goono-note-tablet",
  "private": true,
  "version": "0.1.0",
  "description": "구노 연구노트 태블릿 앱 — 오프라인 작성 후 구노 ELN에 동기화 (iPad·갤럭시 탭)",
  "type": "module",
  "scripts": {
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "node mock-server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "cap:sync": "npm run build && cap sync",
    "assets": "node scripts/copy-assets.mjs",
    "build:demo": "npm run assets && tsc --noEmit && VITE_DEMO=1 vite build --outDir dist-demo",
    "ios:dev": "npm run assets && tsc --noEmit && VITE_ALLOW_DEMO=1 vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "ketcher-core": "^3.14.0",
    "ketcher-react": "^3.14.0",
    "ketcher-standalone": "^3.14.0",
    "mathjax-full": "^3.2.2",
    "mathlive": "^0.107.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "playwright": "^1.59.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16"
  }
}
