<?xml version="1.0" encoding="utf-8"?>
<!-- 연구노트 데이터는 클라우드 백업·기기 간 이전 대상에서 뺀다 (암호화 키가 키스토어에 묶여 있어 옮겨도 열 수 없고,
     작성 기록은 구노 서버로 동기화하는 것이 원본 경로다) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
